<Window x:Class="CadenceSongSync.Views.CopyProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cadence SongSync - Copying Tracks"
        Width="480" Height="260"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        ResizeMode="NoResize"
        Loaded="Window_Loaded"
        Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#991B1B" />
            <Setter Property="BorderBrush" Value="#DC2626" />
        </Style>

        <Style x:Key="SuccessBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#059669" />
            <Setter Property="BorderBrush" Value="#10B981" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <!-- Title & Destination -->
            <RowDefinition Height="Auto" />
            <!-- Progress Bar & Readouts -->
            <RowDefinition Height="*" />
            <!-- Action / Cancel -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock x:Name="TxtHeader" Text="Copying Playlist to Drive..." FontSize="16" FontWeight="Bold" Foreground="#F8FAFC" />
            <TextBlock x:Name="TxtDestination" Text="Destination: E:\Music" FontSize="11" Foreground="#94A3B8" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        </StackPanel>

        <!-- Progress Details -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Current File -->
            <TextBlock x:Name="TxtCurrentFile" Text="Preparing..." FontSize="12" Foreground="#38BDF8" TextTrimming="CharacterEllipsis" Margin="0,0,0,6" />

            <!-- Progress Bar -->
            <ProgressBar x:Name="PbOverall" Height="14" Minimum="0" Maximum="100" Value="0"
                         Background="#1E293B" Foreground="#0EA5E9" BorderBrush="#334155" Margin="0,0,0,6" />

            <!-- Counts & Size Readout -->
            <Grid>
                <TextBlock x:Name="TxtTrackCount" Text="0 / 0 tracks" FontSize="11" Foreground="#94A3B8" />
                <TextBlock x:Name="TxtPercent" Text="0%" FontSize="11" FontWeight="Bold" Foreground="#F1F5F9" HorizontalAlignment="Right" />
            </Grid>
        </StackPanel>

        <!-- Footer / Cancel Button -->
        <Grid Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="TxtStatusMessage" Text="Copying in background..." FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
            <Button x:Name="BtnAction" Style="{StaticResource DangerBtn}" HorizontalAlignment="Right" Click="BtnAction_Click">
                <TextBlock x:Name="TxtActionLabel" Text="Cancel" />
            </Button>
        </Grid>
    </Grid>
</Window>
