<Window x:Class="CadenceSongSync.Views.SplashScreenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadence SongSync"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight">

    <Grid Margin="16">
        <Border CornerRadius="12" Background="Transparent">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.75" />
            </Border.Effect>
            <Image x:Name="ImgSplash"
                   Stretch="Uniform"
                   MaxWidth="600"
                   MaxHeight="400"
                   RenderOptions.BitmapScalingMode="HighQuality" />
        </Border>
    </Grid>
</Window>
