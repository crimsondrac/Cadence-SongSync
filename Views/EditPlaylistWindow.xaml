<Window x:Class="CadenceSongSync.Views.EditPlaylistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:CadenceSongSync.Converters"
        mc:Ignorable="d"
        Title="Cadence SongSync - Edit Playlist"
        Width="1050" Height="680"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        Closing="Window_Closing">

    <Window.Resources>
        <converters:MissingToBrushConverter x:Key="MissingToBrushConverter" />
        <converters:MissingToVisibilityConverter x:Key="MissingToVisibilityConverter" />

        <Style x:Key="ToolbarBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryToolbarBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#0EA5E9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="DangerToolbarBtn" TargetType="Button" BasedOn="{StaticResource ToolbarBtn}">
            <Setter Property="Background" Value="#991B1B" />
            <Setter Property="BorderBrush" Value="#DC2626" />
        </Style>

        <!-- Modern Dark ComboBox Toggle Button -->
        <ControlTemplate x:Key="ComboBoxToggleButton" TargetType="ToggleButton">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>
                <Border x:Name="Border"
                        Grid.ColumnSpan="2"
                        CornerRadius="6"
                        Background="#0F172A"
                        BorderBrush="#475569"
                        BorderThickness="1" />
                <Border Grid.Column="0"
                        CornerRadius="6,0,0,6"
                        Margin="1"
                        Background="#0F172A" />
                <Path x:Name="Arrow"
                      Grid.Column="1"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Data="M 0 0 L 4 4 L 8 0 Z"
                      Fill="#94A3B8" />
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#38BDF8" />
                    <Setter TargetName="Arrow" Property="Fill" Value="#38BDF8" />
                </Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Border" Property="BorderBrush" Value="#0EA5E9" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- Dark Theme ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#0F172A" />
            <Setter Property="BorderBrush" Value="#475569" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Template="{StaticResource ComboBoxToggleButton}"
                                          Focusable="false"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press" />
                            <ContentPresenter x:Name="ContentSite"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              Margin="10,6,30,6"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left" />
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Grid x:Name="DropDown"
                                      SnapsToDevicePixels="True"
                                      MinWidth="{TemplateBinding ActualWidth}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border x:Name="DropDownBorder"
                                            Background="#1E293B"
                                            BorderThickness="1"
                                            BorderBrush="#475569"
                                            CornerRadius="6"
                                            Margin="0,2,0,4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5" />
                                        </Border.Effect>
                                        <ScrollViewer Margin="2" SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark Theme ComboBoxItem Style -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Border"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True"
                                Background="{TemplateBinding Background}"
                                CornerRadius="4"
                                Margin="2,1">
                            <ContentPresenter ContentSource="Content" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#0284C7" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <!-- Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Split Pane -->
            <RowDefinition Height="*" />
            <!-- Status Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarBtn}" Click="BtnNew_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📄" Margin="0,0,6,0" />
                            <TextBlock Text="Create New" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryToolbarBtn}" Click="BtnSave_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="💾" Margin="0,0,6,0" />
                            <TextBlock Text="Save" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolbarBtn}" Click="BtnSaveAs_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="📋" Margin="0,0,6,0" />
                            <TextBlock Text="Save As..." />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource DangerToolbarBtn}" Click="BtnDeletePlaylist_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" Margin="0,0,6,0" />
                            <TextBlock Text="Delete Playlist" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolbarBtn}" Margin="0" Click="BtnClose_Click">
                        <TextBlock Text="Close" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Split Pane Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Panel: File Browser -->
                <ColumnDefinition Width="420" MinWidth="260" />
                <!-- Grid Splitter -->
                <ColumnDefinition Width="8" />
                <!-- Right Panel: Playlist Tracks -->
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- Left Panel: Drive Selector, Folder Tree, File List -->
            <Border Grid.Column="0" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="180" MinHeight="80" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="100" />
                    </Grid.RowDefinitions>

                    <!-- Drive Selector -->
                    <TextBlock Grid.Row="0" Text="SELECT DRIVE:" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
                    <ComboBox Grid.Row="1" x:Name="CmbDrives"
                              Margin="0,0,0,8"
                              SelectionChanged="CmbDrives_SelectionChanged" />

                    <!-- Folder Tree -->
                    <Border Grid.Row="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6" Margin="0,0,0,8">
                        <TreeView x:Name="TreeFolders"
                                  Background="Transparent" Foreground="#F8FAFC"
                                  BorderThickness="0"
                                  SelectedItemChanged="TreeFolders_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="{x:Type TreeViewItem}">
                                    <EventSetter Event="Expanded" Handler="TreeItem_Expanded" />
                                    <Setter Property="Foreground" Value="#E2E8F0" />
                                    <Setter Property="Padding" Value="2" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" Margin="2,1">
                                        <TextBlock Text="📁" Margin="0,0,6,0" />
                                        <TextBlock Text="{Binding Header}" Foreground="#E2E8F0" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </Border>

                    <!-- File List Label & Instructions -->
                    <Grid Grid.Row="3" Margin="0,0,0,4">
                        <TextBlock Text="AUDIO FILES (Drag into playlist):" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtFileCount" Text="0 files" FontSize="10" Foreground="#64748B" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>

                    <!-- File List -->
                    <Border Grid.Row="4" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                        <ListView x:Name="LstAudioFiles"
                                  Background="Transparent" Foreground="#F8FAFC"
                                  BorderThickness="0"
                                  SelectionMode="Extended"
                                  PreviewMouseLeftButtonDown="LstAudioFiles_PreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="LstAudioFiles_PreviewMouseLeftButtonUp"
                                  MouseMove="LstAudioFiles_MouseMove">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="Padding" Value="4,3" />
                                    <Setter Property="Foreground" Value="#E2E8F0" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E293B" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#0369A1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="220" DisplayMemberBinding="{Binding Name}" />
                                    <GridViewColumn Header="Size" Width="80" DisplayMemberBinding="{Binding FormattedSize}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>
                </Grid>
            </Border>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Stretch" />

            <!-- Right Panel: Playlist Tracks -->
            <Border Grid.Column="2" Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Playlist Name & Details -->
                        <RowDefinition Height="Auto" />
                        <!-- Playlist Tracks List -->
                        <RowDefinition Height="*" />
                        <!-- Action Footer / Trash Target -->
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Playlist Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="PLAYLIST TITLE:" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,4" />
                            <TextBox x:Name="TxtPlaylistTitle"
                                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"
                                     Background="#0F172A" Foreground="#F8FAFC"
                                     BorderBrush="#475569" Padding="8,5" FontSize="14" FontWeight="SemiBold"
                                     TextChanged="TxtPlaylistTitle_TextChanged" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
                            <TextBlock x:Name="TxtDirtyIndicator" Text="● Unsaved changes" Foreground="#F59E0B" FontSize="11"
                                       HorizontalAlignment="Right" Visibility="Collapsed" Margin="0,0,0,4" />
                            <TextBlock x:Name="TxtPlaylistStats" Text="0 tracks" Foreground="#94A3B8" FontSize="11"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <!-- Tracks ListView (Drop target, reorderable, delete key) -->
                    <Border Grid.Row="1" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="6">
                        <ListView x:Name="LstPlaylistTracks"
                                  ItemsSource="{Binding Tracks}"
                                  Background="Transparent" Foreground="#F8FAFC"
                                  BorderThickness="0"
                                  SelectionMode="Extended"
                                  AllowDrop="True"
                                  DragOver="LstPlaylistTracks_DragOver"
                                  Drop="LstPlaylistTracks_Drop"
                                  PreviewMouseLeftButtonDown="LstPlaylistTracks_PreviewMouseLeftButtonDown"
                                  PreviewMouseLeftButtonUp="LstPlaylistTracks_PreviewMouseLeftButtonUp"
                                  MouseMove="LstPlaylistTracks_MouseMove"
                                  KeyDown="LstPlaylistTracks_KeyDown">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="4,4" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#1E293B" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#0369A1" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>

                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="#" Width="36" DisplayMemberBinding="{Binding TrackNumberString}" />
                                    <GridViewColumn Header="Title" Width="240">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Foreground="{Binding IsMissing, Converter={StaticResource MissingToBrushConverter}}" />
                                                    <TextBlock Text=" (Missing)" Foreground="#EF4444" FontSize="10" FontWeight="Bold" Margin="6,0,0,0"
                                                               Visibility="{Binding IsMissing, Converter={StaticResource MissingToVisibilityConverter}}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Duration" Width="70" DisplayMemberBinding="{Binding DurationString}" />
                                    <GridViewColumn Header="File Path" Width="300" DisplayMemberBinding="{Binding FilePath}" />
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Border>

                    <!-- Footer: Reorder Hints and Trash Drop Target -->
                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="💡 Tip: Drag tracks to reorder. Multi-select and press Delete or drag to Trash to remove."
                                       FontSize="11" Foreground="#64748B" />
                        </StackPanel>

                        <!-- On-Screen Trash Target -->
                        <Border Grid.Column="1"
                                x:Name="BorderTrash"
                                Background="#331A1E"
                                BorderBrush="#EF4444"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,8"
                                AllowDrop="True"
                                DragEnter="BorderTrash_DragEnter"
                                DragLeave="BorderTrash_DragLeave"
                                DragOver="BorderTrash_DragOver"
                                Drop="BorderTrash_Drop"
                                Cursor="Hand"
                                ToolTip="Drop tracks here to delete from playlist">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🗑️" FontSize="14" Margin="0,0,6,0" />
                                <TextBlock x:Name="TxtTrashLabel" Text="Drop here to Remove" FontSize="12" FontWeight="SemiBold" Foreground="#FCA5A5" />
                            </StackPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Grid Grid.Row="2" Margin="4,8,4,0">
            <TextBlock x:Name="TxtStatus" Text="Ready" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" />
            <TextBlock x:Name="TxtFilePathStatus" Text="{Binding FilePath, FallbackValue='New unsaved playlist'}"
                       FontSize="11" Foreground="#94A3B8" HorizontalAlignment="Right" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
