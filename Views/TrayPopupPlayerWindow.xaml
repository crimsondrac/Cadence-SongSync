<Window x:Class="CadenceSongSync.Views.TrayPopupPlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:CadenceSongSync.Converters"
        mc:Ignorable="d"
        Title="Cadence SongSync"
        Width="380" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Deactivated="Window_Deactivated">

    <Window.Resources>
        <converters:MissingToBrushConverter x:Key="MissingToBrushConverter" />
        <converters:MissingToVisibilityConverter x:Key="MissingToVisibilityConverter" />
        <converters:RepeatModeToTextConverter x:Key="RepeatModeToTextConverter" />
        <converters:BooleanToActiveBrushConverter x:Key="BooleanToActiveBrushConverter" />

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Background" Value="#2D3748" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#3E4C63" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#1E293B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#1E2430" />
        </Style>

        <Style x:Key="PrimaryCircleButton" TargetType="Button">
            <Setter Property="Width" Value="48" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Background" Value="#0EA5E9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0284C7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#12161F"
            BorderBrush="#2A3447"
            BorderThickness="1"
            CornerRadius="12"
            Margin="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.5" />
        </Border.Effect>

        <Grid Margin="12">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Current track info -->
                <RowDefinition Height="Auto" />
                <!-- Track list -->
                <RowDefinition Height="*" />
                <!-- Progress scrubber -->
                <RowDefinition Height="Auto" />
                <!-- Controls -->
                <RowDefinition Height="Auto" />
                <!-- Bottom bar (volume & copy) -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header Row -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/assets/images/icon_32x32.png"
                           Width="24" Height="24"
                           Margin="0,0,8,0"
                           VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="CURRENT PLAYLIST" FontSize="9" FontWeight="Bold" Foreground="#38BDF8" />
                        <TextBlock x:Name="TxtPlaylistTitle"
                                   Text="{Binding AudioPlayer.PlaylistTitle, FallbackValue='No Playlist Loaded'}"
                                   FontWeight="Bold" FontSize="14" Foreground="#F8FAFC"
                                   TextTrimming="CharacterEllipsis" MaxWidth="210"
                                   ToolTip="{Binding AudioPlayer.PlaylistTitle}" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,0,4,0"
                            ToolTip="Load Playlist" Click="BtnLoadPlaylist_Click">
                        <TextBlock Text="📂" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28" Margin="0,0,4,0"
                            ToolTip="Edit Playlist" Click="BtnEditPlaylist_Click">
                        <TextBlock Text="✏️" FontSize="12" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                            ToolTip="Close Player Popup" Click="BtnClose_Click">
                        <TextBlock Text="✕" FontSize="12" Foreground="#94A3B8" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Current Playing Banner -->
            <Border Grid.Row="1" Background="#1A2130" CornerRadius="8" Padding="10,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,2" />
                        <TextBlock x:Name="TxtCurrentTrackTitle"
                                   Text="{Binding AudioPlayer.CurrentTrack.DisplayName, FallbackValue='(None)'}"
                                   FontWeight="SemiBold" FontSize="13" Foreground="#F1F5F9"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Border Grid.Column="1" Background="#222C3F" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AudioPlayer.CurrentTrack.DurationString, FallbackValue='--:--'}"
                                   FontSize="11" Foreground="#94A3B8" />
                    </Border>
                </Grid>
            </Border>

            <!-- Track List -->
            <Border Grid.Row="2" Background="#161C27" CornerRadius="8" BorderBrush="#222C3F" BorderThickness="1" Margin="0,0,0,8">
                <ListBox x:Name="LstTracks"
                         ItemsSource="{Binding AudioPlayer.CurrentPlaylist.Tracks}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MouseDoubleClick="LstTracks_MouseDoubleClick"
                         VirtualizingStackPanel.IsVirtualizing="True">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="4,3" />
                            <Setter Property="Margin" Value="2,1" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderThickness="1"
                                                BorderBrush="Transparent"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#222C3F" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#1E2D48" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0284C7" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#133352" />
                                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#0EA5E9" />
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding StatusTooltip}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="26" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Track # or Playing Speaker -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding TrackNumberString}"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center" />

                                <!-- Title and Status -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="12"
                                               FontWeight="Normal"
                                               Foreground="{Binding IsMissing, Converter={StaticResource MissingToBrushConverter}}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="File missing"
                                               FontSize="9"
                                               Foreground="#EF4444"
                                               Visibility="{Binding IsMissing, Converter={StaticResource MissingToVisibilityConverter}}" />
                                </StackPanel>

                                <!-- Duration -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding DurationString}"
                                           FontSize="11"
                                           Foreground="#64748B"
                                           VerticalAlignment="Center"
                                           Margin="4,0" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Progress Scrubber -->
            <Grid Grid.Row="3" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="38" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding AudioPlayer.PositionString, FallbackValue='0:00'}"
                           FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Left" />

                <Slider Grid.Column="1"
                        x:Name="SliderProgress"
                        Minimum="0" Maximum="1"
                        Value="{Binding AudioPlayer.ProgressFraction, Mode=OneWay}"
                        PreviewMouseDown="SliderProgress_PreviewMouseDown"
                        PreviewMouseUp="SliderProgress_PreviewMouseUp"
                        VerticalAlignment="Center"
                        Margin="4,0" />

                <TextBlock Grid.Column="2" Text="{Binding AudioPlayer.DurationString, FallbackValue='0:00'}"
                           FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>

            <!-- Playback Controls -->
            <Grid Grid.Row="4" Margin="0,4,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left sub-controls: Shuffle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}"
                            x:Name="BtnShuffle"
                            ToolTip="Random Play (Shuffle queue without repeats)"
                            Click="BtnShuffle_Click"
                            Background="{Binding AudioPlayer.IsRandom, Converter={StaticResource BooleanToActiveBrushConverter}}">
                        <TextBlock Text="🔀" FontSize="13" />
                    </Button>
                </StackPanel>

                <!-- Center main controls: Prev, Play/Pause, Stop, Next -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" Margin="4,0" ToolTip="Previous Track" Click="BtnPrev_Click">
                        <TextBlock Text="⏮" FontSize="14" />
                    </Button>
                    <Button Style="{StaticResource PrimaryCircleButton}" Margin="6,0" ToolTip="Play / Pause" Click="BtnPlayPause_Click">
                        <TextBlock x:Name="TxtPlayPauseIcon" Text="▶" FontSize="18" Margin="2,0,0,0" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Margin="4,0" ToolTip="Stop" Click="BtnStop_Click">
                        <TextBlock Text="⏹" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource IconButton}" Margin="4,0" ToolTip="Next Track" Click="BtnNext_Click">
                        <TextBlock Text="⏭" FontSize="14" />
                    </Button>
                </StackPanel>

                <!-- Right sub-controls: Repeat -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}"
                            x:Name="BtnRepeat"
                            ToolTip="{Binding AudioPlayer.RepeatModeTooltip}"
                            Click="BtnRepeat_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔁" FontSize="12" />
                            <TextBlock Text="{Binding AudioPlayer.RepeatMode, Converter={StaticResource RepeatModeToTextConverter}}"
                                       FontSize="9" FontWeight="Bold" Foreground="#38BDF8" Margin="2,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Bottom Row: Volume Slider & Copy to Drive Button -->
            <Grid Grid.Row="5" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Volume -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔊" FontSize="12" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider Minimum="0" Maximum="1" Width="70"
                            Value="{Binding AudioPlayer.Volume, Mode=TwoWay}"
                            VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AudioPlayer.VolumePercent, StringFormat='{}{0}%'}"
                               FontSize="10" Foreground="#94A3B8" Width="30" TextAlignment="Right"
                               VerticalAlignment="Center" Margin="2,0,0,0" />
                </StackPanel>

                <!-- Copy to Drive Button -->
                <Button Grid.Column="1"
                        Style="{StaticResource ModernButton}"
                        Background="#0284C7"
                        Padding="12,6"
                        HorizontalAlignment="Right"
                        Click="BtnCopyToDrive_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Copy Playlist to Drive" FontWeight="SemiBold" FontSize="12" />
                    </StackPanel>
                </Button>
            </Grid>

        </Grid>
    </Border>
</Window>
