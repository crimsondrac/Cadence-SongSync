<Window x:Class="CadenceSongSync.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cadence SongSync - Settings"
        Width="580" Height="700"
        WindowStartupLocation="CenterScreen"
        Background="#0F172A"
        Foreground="#F8FAFC"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style x:Key="ModernBtn" TargetType="Button">
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#334155" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F172A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button" BasedOn="{StaticResource ModernBtn}">
            <Setter Property="Background" Value="#0284C7" />
            <Setter Property="BorderBrush" Value="#0EA5E9" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Settings" FontSize="18" FontWeight="Bold" Foreground="#F8FAFC" />
                <TextBlock Text="Configure drive copy behaviors, startup, and file handling."
                           FontSize="12" Foreground="#94A3B8" Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <!-- Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Startup & Notifications Group -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="STARTUP &amp; NOTIFICATIONS" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                        <CheckBox x:Name="ChkStartWithWindows" Margin="0,0,0,10" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                                <TextBlock Text="Registers SongSync in Windows startup to launch minimized to the system tray." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkHideSplashBanner" Margin="0,0,0,0" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Hide splash banner on startup" FontWeight="SemiBold" />
                                <TextBlock Text="Suppresses the notification balloon banner when the application starts." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Playlist Editor Starting Folder Group -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PLAYLIST EDITOR FOLDER" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                        <CheckBox x:Name="ChkEditorOpenLastFolder" Margin="0,0,0,10" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Open in last browsed folder" FontWeight="SemiBold" />
                                <TextBlock Text="Automatically reopen the folder you were last browsing when opening the Playlist Editor." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </CheckBox>

                        <TextBlock Text="Default Starting Folder:" FontWeight="SemiBold" Foreground="#F1F5F9" Margin="0,4,0,2" />
                        <TextBlock Text="Starting directory if last folder is disabled or unavailable." FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtEditorStartingFolder"
                                     Background="#0F172A" Foreground="#F8FAFC"
                                     BorderBrush="#475569" Padding="8,6" FontSize="12" />

                            <Button Grid.Column="1" Style="{StaticResource ModernBtn}"
                                    Margin="8,0,0,0" Padding="12,6"
                                    Click="BtnBrowseStartingFolder_Click">
                                <TextBlock Text="Browse..." />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Folder Structure Group -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DESTINATION FOLDER STRUCTURE" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                        <RadioButton x:Name="RbFolderImmediate" GroupName="FolderStructureMode" Margin="0,0,0,8" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Recreate source folder (e.g. My Songs\Song.mp3)" FontWeight="SemiBold" />
                                <TextBlock Text="Copies songs into their containing folder name. Automatically creates the folder if it does not exist." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RbFolderRelative" GroupName="FolderStructureMode" Margin="0,0,0,8" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Recreate full relative folder structure (e.g. Artist\Album\Song.mp3)" FontWeight="SemiBold" />
                                <TextBlock Text="Preserves nested subfolders relative to playlist directory or library." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RbFolderFlat" GroupName="FolderStructureMode" Margin="0,0,0,0" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Flat (root folder only)" FontWeight="SemiBold" />
                                <TextBlock Text="Copies all audio files directly into the destination folder without creating subfolders." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Playlist Export Mode Group -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="PLAYLIST EXPORT MODE" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                        <RadioButton x:Name="RbExportGenerateM3U8" GroupName="PlaylistExportMode" Margin="0,0,0,8" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Generate new synced .m3u8 playlist (Recommended)" FontWeight="SemiBold" />
                                <TextBlock Text="Creates an updated UTF-8 .m3u8 playlist referencing the copied files with relative paths." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RbExportCopyOriginal" GroupName="PlaylistExportMode" Margin="0,0,0,8" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Copy original playlist file as-is" FontWeight="SemiBold" />
                                <TextBlock Text="Preserves the source playlist format (.m3u, .pls, .wpl, .xspf) and filename (requires track filenames not prefixed)." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RbExportNone" GroupName="PlaylistExportMode" Margin="0,0,0,0" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Do not export playlist file" FontWeight="SemiBold" />
                                <TextBlock Text="Sync only the audio files without creating or copying playlist files." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Filename Mode Group -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DEFAULT DESTINATION FILENAME FORMAT" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />
                        
                        <RadioButton x:Name="RbPreserve" GroupName="FilenameMode" Margin="0,0,0,6" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Preserve original filenames" FontWeight="SemiBold" />
                                <TextBlock Text="Maintains original song filenames; never creates duplicate copies on re-sync." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </RadioButton>

                        <RadioButton x:Name="RbPrefixNumber" GroupName="FilenameMode" Margin="0,4,0,0" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Prefix track numbers (e.g. 001 - Song.mp3)" FontWeight="SemiBold" />
                                <TextBlock Text="Prepends ordered zero-padded track numbers so hardware car stereos and MP3 players play in playlist order." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </Border>

                <!-- Sanitization & Drive Options Group -->
                <Border Background="#1E293B" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="DRIVE COMPATIBILITY &amp; CLEANUP" FontSize="11" FontWeight="Bold" Foreground="#38BDF8" Margin="0,0,0,8" />

                        <CheckBox x:Name="ChkSanitize" Margin="0,0,0,10" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Sanitize filenames and folder names for FAT32 / exFAT drives" FontWeight="SemiBold" />
                                <TextBlock Text="Replaces illegal characters (\ / : * ? &quot; &lt; &gt; |) with _ and trims invalid trailing periods/spaces." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </CheckBox>

                        <CheckBox x:Name="ChkClearDestination" Margin="0,0,0,0" Foreground="#F1F5F9">
                            <StackPanel>
                                <TextBlock Text="Clear destination folder before copying" FontWeight="SemiBold" />
                                <TextBlock Text="Removes existing files and subdirectories in the target directory before starting new copy." FontSize="11" Foreground="#94A3B8" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ModernBtn}" Margin="0,0,8,0" Click="BtnCancel_Click">
                    <TextBlock Text="Cancel" />
                </Button>
                <Button Style="{StaticResource PrimaryBtn}" Click="BtnSave_Click">
                    <TextBlock Text="Save Settings" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
